---
import { getCollection, getEntryBySlug } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import NewsList from "@/components/NewsList.astro";
import { formatDateUTC } from "@/lib/dates.ts";

export async function getStaticPaths() {
  const items = await getCollection("newsletters");
  if (!items.length) return [];
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
if (!item) return Astro.redirect("/404");

const { Content } = await item.render();
---

<SiteLayout title={item.data.title ?? item.slug}>
  <main
    class="grid grid-cols-1 sm:grid-cols-[1fr_3fr_1fr] gap-4 [&>*]:min-w-0 [&>*]:[overflow-wrap:anywhere]"
    <aside class="hidden sm:block">
      <div class="sticky top-20 shrink-0 min-w-0 overflow-wrap:anywhere pe-2">
        <NewsList activeId={item.slug} />
      </div>
    </aside>

    <article class="prose dark:prose-invert mx-auto">
      <h2 class="text-xs uppercase">The weekly Vivarium for Week {item.data.week}</h2>
      <h1>{item.data.title ?? item.slug}</h1>
      <Content />
      <hr />
      {item.data.date && <p class="text-sm">{formatDateUTC(item.data.date)}</p>}
    </article>
  </main>
</SiteLayout>
