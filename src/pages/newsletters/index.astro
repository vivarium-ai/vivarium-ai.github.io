---
import { getCollection } from "astro:content";
import SiteLayout from '@/layouts/SiteLayout.astro';
import NewsList from "@/components/NewsList.astro";

const all = await getCollection("newsletters");
const items = all.filter((p) => p.data.published !== false);
const item = items.at(-1);

const { Content } = await item.render();
---

<SiteLayout title="Vivarium - Newsletters">
  <main
    class="grid grid-cols-1 sm:grid-cols-[1fr_3fr_1fr] gap-4 [&>*]:min-w-0 [&>*]:[overflow-wrap:anywhere]"
  >
    <aside class="block">
      <div class="sticky top-20 shrink-0 min-w-0 overflow-wrap:anywhere pe-2">
        <NewsList activeId="" />
      </div>
    </aside>

    <article class="prose dark:prose-invert mx-auto">
      <h2 class="text-xs uppercase">The weekly Vivarium for Week {item.data.week}</h2>
      <h1>{item.data.title ?? item.slug}</h1>
      <Content />
      <hr />
      {item.data.date && <p class="text-sm">{item.data.date}</p>}
    </article>
  </main>
</SiteLayout>
