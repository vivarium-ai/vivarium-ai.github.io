---
import ShowHide from "@/components/ShowHide.jsx";
import { Icon } from "solid-heroicons";
import { chevronDoubleLeft, chevronDoubleRight } from "solid-heroicons/solid";

import { getBlogList, isActivePath } from "@/lib/blog";
const blogLinks = await getBlogList();

const { activeId } = Astro.props;
---

<nav aria-label="All blog posts" class="text-sm">
  <div class="flex items-center gap-3">
    <h2 class="mb-2 px-2 inline text-xs font-semibold uppercase tracking-wide opacity-70">
      Blog posts
    </h2>

    <button
      id="toggle-blog-index"
      aria-expanded="false"
      aria-label="Toggle blog index navigation"
      class="hidden items-right p-2 rounded-md border border-neutral-300 dark:border-neutral-700"
    >
      <Icon id="icon-index-expand" path={chevronDoubleRight } class="h-6 w-6" />
      <Icon id="icon-index-collapse" path={chevronDoubleLeft } class="h-6 w-6 hidden" />
    </button>
  </div>

  <ul id="small-screen-index" class="space-y-1">
    {blogLinks.map((it) => {
      const isActive = isActivePath(it.path, activeId);
      return (
        <li>
          <a
            href={it.path}
            aria-current={isActive ? "page" : undefined}
            class={
              "block rounded-md px-2 py-1.5 outline-none ring-0 transition " +
              (isActive
                ? "bg-fg/10 font-medium"
                : "hover:bg-fg/5 focus:bg-fg/5")
            }
          >
            {it.title}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<ShowHide
  client:load
  targetId="small-screen-index"
  toggleId="toggle-blog-index"
  showIconId="icon-index-expand"
  hideIconId="icon-index-collapse"
/>
