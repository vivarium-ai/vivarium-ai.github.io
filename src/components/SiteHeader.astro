---
import SocialIcons from "@/components/SocialIcons.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";

import { Icon } from "solid-heroicons";
import { bars_4, xMark } from "solid-heroicons/solid";
---

<header class="flex items-center justify-between h-14">
  <div class="flex items-center gap-2">
    <a href="/" class="inline-flex items-center">
      <img
        src="/vivarium-logo.jpg"
        width="40"
        height="40"
        class="rounded-sm"
        alt="Vivarium"
      />
    </a>
  </div>

  <nav class="hidden md:flex gap-4 text-sm items-end">
    <a class="hover:underline" href="/blog/">Blog</a>
    <a class="hover:underline" href="/docs/">Docs</a>
    <a class="hover:underline" href="/newsletters/">Newsletters</a>
    <a class="hover:underline" href="/events">Events</a>

    <SocialIcons />
    <ThemeSwitch />
  </nav>

  <div class="md:hidden flex items-center gap-3">
    <button
      id="menu-toggle"
      aria-expanded="false"
      aria-label="Toggle navigation"
      class="p-2 rounded-md border border-neutral-300 dark:border-neutral-700"
    >
      <Icon id="icon-menu" path={bars_4} class="h-6 w-6" />
      <Icon id="icon-close" path={xMark} class="h-6 w-6 hidden" />
    </button>
  </div>
</header>

<nav
  id="mobile-nav"
  class="md:hidden hidden flex flex-col gap-2 text-sm mt-2 pb-2 border-b border-neutral-200 dark:border-neutral-700"
>
  <a class="py-1 hover:underline" href="/blog/">Blog</a>
  <a class="py-1 hover:underline" href="/docs/">Docs</a>
  <a class="py-1 hover:underline" href="/newsletters/">Newsletters</a>
  <a class="py-1 hover:underline" href="/events">Events</a>

  <div class="pt-2">
    <SocialIcons />
  </div>

  <div class="flex items-center justify-between pt-2">
    <ThemeSwitch />
  </div>
</nav>

<script>
  let open = false;

  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-nav");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  btn.addEventListener("click", () => {
    open = !open;
    menu.classList.toggle("hidden");
    iconMenu.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
